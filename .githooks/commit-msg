#!/bin/sh
# Validates Conventional Commits (docs/06 §2) and DCO sign-off. Activated by `cargo xtask setup`
# (git config core.hooksPath .githooks).
msg_file="$1"
subject=$(head -n1 "$msg_file")

# Allow merge/revert/fixup generated messages
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

echo "$subject" | grep -Eq '^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$' || {
  echo "error: commit subject must follow Conventional Commits, e.g. 'feat(vt): handle OSC 133'" >&2
  exit 1
}

grep -q '^Signed-off-by: ' "$msg_file" || {
  echo "error: missing 'Signed-off-by:' trailer (use git commit -s)" >&2
  exit 1
}
